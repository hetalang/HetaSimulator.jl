c1 @Compartment .= 1;
threeshold @Const = 1.5;
k1 @Const = 0.001;
k2 @Const = 0.001;
k3 @Const = 0.001;
k4 @Const = 0.001;
k5 @Const = 0.001;
k6 @Const = 0.001;
s1 @Species { compartment: c1, output: true } .= 1;
s2 @Species { compartment: c1, output: true } .= 1;
s3 @Species { compartment: c1, output: true } .= 1;
s4 @Species { compartment: c1, output: true } .= 1;
s5 @Species { compartment: c1, output: true } .= 1;
s6 @Species { compartment: c1, output: true } .= 1;
r1 @Reaction { actors: s1 -> } := k1*s1*c1;
r2 @Reaction { actors: s2 -> } := k2*s2*c1;
r3 @Reaction { actors: s3 -> } := k3*s3*c1;
r4 @Reaction { actors: s4 -> } := k4*s4*c1;
r5 @Reaction { actors: s5 -> } := k5*s5*c1;
r6 @Reaction { actors: s6 -> } := k6*s6*c1;
sw1 @TimeSwitcher { start: 0, period: 12, atStart: true };
sw2 @TimeSwitcher { start: 1, period: 12, atStart: true };
sw3 @CSwitcher { trigger: threeshold-s3, atStart: true };
sw4 @CSwitcher { trigger: threeshold-s4, atStart: false };
sw5 @DSwitcher { trigger: s5<threeshold, atStart: true };
sw6 @DSwitcher { trigger: s6<threeshold, atStart: false };
s1 [sw1]= s1+1/c1;
s2 [sw2]= s2+1/c1;
s3 [sw3]= s3+1/c1;
s4 [sw4]= s4+1/c1;
s5 [sw5]= s5+1/c1;
s6 [sw6]= s6+1/c1;
